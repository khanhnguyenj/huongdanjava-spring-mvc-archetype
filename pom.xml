<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.huongdanjava</groupId>
  <artifactId>huongdanjava-springmvc-archetype</artifactId>
  <version>3.0.0</version>
  <packaging>maven-archetype</packaging>
  <name>huongdanjava-springmvc-archetype</name>
  <description>Huong Dan Java - Spring MVC Maven Archetype project.</description>

  <developers>
    <developer>
      <name>Khanh Nguyen</name>
    </developer>
  </developers>

  <organization>
    <name>Huong Dan Java</name>
    <url>https://huongdanjava.com/</url>
  </organization>
  <url>https://github.com/khanhnguyenj/huongdanjava-spring-mvc-archetype</url>
  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/khanhnguyenj/huongdanjava-spring-mvc-archetype.git
    </connection>
    <developerConnection>
      scm:git:ssh://git@github.com/khanhnguyenj/huongdanjava-spring-mvc-archetype.git
    </developerConnection>
    <url>https://github.com/khanhnguyenj/huongdanjava-spring-mvc-archetype</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
  </properties>

  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>3.4.1</version>
      </extension>
    </extensions>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <version>3.2.8</version>
        <executions>
          <execution>
            <id>sign-artifacts</id>
            <phase>verify</phase>
            <goals>
              <goal>sign</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.12.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
